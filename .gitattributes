# Normalize line endings so the macOS CI build sees consistent files.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.xcassets/** binary
*.mlmodel binary

# Explicitly text
*.swift text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
*.xcconfig text eol=lf
*.storyboard text eol=lf
*.json text eol=lf
*.md text eol=lf

# Generated by XcodeGen on the build machine
*.xcodeproj/
build/
DerivedData/
*.ipa
*.xcarchive
.DS_Store